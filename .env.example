# Client: where the browser reaches the Socket.IO server. Inlined at build
# time, so it must be set on the build, not just at runtime.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Multiplayer realtime server
# Port the Socket.IO server binds to (default 3001).
PORT=3001
# Comma separated list of browser origins allowed to connect (CORS).
FRONTEND_URL=http://localhost:3000

# PostHog Analytics & Session Recording
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional: Set to "true" to route analytics through Next.js reverse proxy (/ingest)
# The realtime server needs an absolute host; it cannot use the /ingest proxy.
NEXT_PUBLIC_POSTHOG_USE_PROXY=false
